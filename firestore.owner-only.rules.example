rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/appData/{docId} {
      function isOwner() {
        return request.auth != null
          && request.auth.uid == userId
          && request.auth.uid == 'PASTE_YOUR_UID'
          && docId == 'calculator';
      }
      allow read: if isOwner();
      allow create, update: if isOwner()
        && request.resource.data.keys().hasOnly(['payload', 'updatedAt'])
        && request.resource.data.payload is map
        && request.resource.data.payload.transactions is list
        && request.resource.data.payload.transactions.size() <= 10000;
      allow delete: if isOwner();
    }
  }
}
